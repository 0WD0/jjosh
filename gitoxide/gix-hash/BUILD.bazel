load("@gitoxide_crates//:data.bzl", "DEP_DATA")
load("@gitoxide_crates//:defs.bzl", "aliases", "all_crate_deps", "all_crate_features")
load("@rules_rust//rust:defs.bzl", "rust_library")

_CRATE = DEP_DATA[package_name()]

exports_files(
    [
        "Cargo.toml",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "gix-hash",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    crate_features = all_crate_features(),
    crate_name = _CRATE["crate_name"],
    crate_root = "src/lib.rs",
    edition = _CRATE["edition"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    version = _CRATE["version"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)
