load("@jjosh_crates//:data.bzl", "DEP_DATA")
load("@jjosh_crates//:defs.bzl", "aliases", "all_crate_deps", "all_crate_features")
load("@rules_rust//rust:defs.bzl", "rust_binary")

_CRATE = DEP_DATA[package_name()]

exports_files(["Cargo.toml"], visibility = ["//visibility:public"])

rust_binary(
    name = "jjosh",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        exclude = ["src/**/*.rs"],
    ),
    crate_features = all_crate_features(),
    crate_root = "src/main.rs",
    edition = _CRATE["edition"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    version = _CRATE["version"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)
